# OBV npm configuration — deterministic, supply-chain-conservative installs.
#
# ignore-scripts: dependency lifecycle scripts (preinstall/install/postinstall)
#   never execute. For a lender pilot this removes the largest npm
#   supply-chain execution surface: installing a package cannot run code.
#   Scripts invoked explicitly (npm run build, npm test, npm start) are
#   unaffected. Playwright's browser download is therefore an EXPLICIT,
#   auditable step: npm run browsers.
#
# save-exact: any future `npm install <pkg>` records an exact version, so the
#   lockfile and package.json never drift into floating ranges.
#
# engine-strict: refuse to install under a Node that does not satisfy
#   package.json engines (node:sqlite requires >= 22.5).
ignore-scripts=true
save-exact=true
engine-strict=true
fund=false

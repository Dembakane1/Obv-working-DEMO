# OBV environment configuration — names only, never real values.
# Copy to .env (gitignored) for local use, or set these in your hosting
# platform's environment settings. Every variable is optional: with no
# configuration at all, OBV runs the full demo (deterministic fallback
# verification, in-app notifications, PDF reports if Chromium is present).

# ============================== REQUIRED ==============================
# (none — OBV boots and demos fully with zero configuration)
#
# PORT is provided by the hosting platform (Render sets it automatically;
# the Docker image defaults to 10000, local default is 3000).
# PORT=3000

# ========================= OPTIONAL — AI ==============================
# Anthropic API key enabling live multimodal visual assessment of
# evidence photos. Server-side only: never sent to the browser, never
# logged, never committed. Without it, verification uses the
# deterministic demo path (MOCK_DEFAULT) and everything still works.
ANTHROPIC_API_KEY=

# Overrides (defaults shown).
# OBV_AI_MODEL=claude-haiku-4-5-20251001
# OBV_AI_TIMEOUT_MS=8000
# OBV_AI_BASE_URL=https://api.anthropic.com

# ======================== OPTIONAL — TEAMS ============================
# Microsoft Teams incoming-webhook URL for governance notifications.
# Server-side only; never exposed client-side, never logged in full.
# Without it, OBV runs in demo notification mode (in-app feed only).
TEAMS_WEBHOOK_URL=

# Overrides (defaults shown).
# TEAMS_NOTIFICATION_TIMEOUT_MS=5000

# Public base URL of this OBV deployment; used for "Open in OBV" links
# on Teams cards. On Render this defaults to RENDER_EXTERNAL_URL, so you
# only need it on other hosts or behind a custom domain.
# OBV_PUBLIC_BASE_URL=https://obv-demo.onrender.com

# ==================== OPTIONAL — TEAMS CONVERSATION SYNC ==============
# Microsoft Graph app credentials enabling two-way coordination-message
# sync between bound OBV threads and Teams channels. Server-side only;
# never sent to the browser, never logged, never committed. Without
# them, sync shows "not configured" and everything else works fully.
# (Event notification cards use TEAMS_WEBHOOK_URL above — separate.)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Delegated send credential (SECRET): refresh token for the dedicated
# OBV service account (delegated ChannelMessage.Send). Application
# permissions cannot post channel messages operationally in real Graph.
# Obtain once with: node scripts/teams-delegated-auth.js
MICROSOFT_SEND_REFRESH_TOKEN=

# Outbound send mode: "delegated" (default, production) or "app-test"
# (contract-stub testing only — hard-blocked against real Graph).
# OBV_TEAMS_SEND_MODE=delegated

# Public HTTPS URL Microsoft Graph calls with change notifications
# (defaults to <OBV_PUBLIC_BASE_URL>/api/teams-sync/notifications).
# OBV_TEAMS_WEBHOOK_PUBLIC_URL=https://obv-demo.onrender.com/api/teams-sync/notifications

# Key letting an external scheduler call POST /api/teams-sync/maintain
# (subscription renewal) with the X-OBV-Maintenance-Key header.
# OBV_TEAMS_MAINTENANCE_KEY=

# Overrides (defaults shown; test suites point these at a local stub).
# OBV_TEAMS_SYNC_TIMEOUT_MS=8000
# OBV_GRAPH_BASE_URL=https://graph.microsoft.com
# OBV_GRAPH_LOGIN_URL=https://login.microsoftonline.com

# ==================== OPTIONAL — WHATSAPP FIELD BRIDGE ================
# WhatsApp Business Cloud API (Meta) credentials enabling the field
# coordination bridge: inbound field messages/media into OBV threads and
# policy-gated outbound coordination. Server-side only; never sent to
# the browser, never logged, never committed. Without them, WhatsApp
# shows "not configured" and everything else works fully.
# Setup guide: docs/WHATSAPP_REAL_SETUP.md
#
# WhatsApp COORDINATES ONLY — nothing arriving on this channel can
# create evidence, satisfy approvals, or release funds.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Value you choose; Meta echoes it during webhook verification.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret used to validate X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=

# Overrides (defaults shown; the test suite points the base URL at a
# local contract stub — production leaves it at Meta's Graph endpoint).
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_SYNC_TIMEOUT_MS=8000
# OBV_WHATSAPP_API_BASE_URL=https://graph.facebook.com

# ======================= OPTIONAL — STORAGE ===========================
# Root directory for ALL runtime data: obv.db (SQLite), uploads/,
# worm/ (immutable evidence), reports/. Point this at a persistent
# volume mount (e.g. /var/data on a Render disk) to survive restarts.
# Default: ./data relative to the working directory (ephemeral in
# containers — a restart reseeds the demo).
# OBV_DATA_DIR=/var/data

# Relocate generated report PDFs separately from the rest of the data
# (rarely needed; default is <OBV_DATA_DIR>/reports).
# OBV_REPORT_STORAGE_PATH=/var/data/reports

# ====================== OPTIONAL — DEPLOYMENT =========================
# Simple deployment-level access protection. When set, every page and
# API (except /api/health) requires this code once per browser; the
# cookie stores only a hash of the code. Leave unset for an open demo.
# OBV_ACCESS_CODE=

# Where the PDF render child process resolves the playwright module.
# The Docker image sets this to /app/node_modules; the local dev
# environment default is /opt/node22/lib/node_modules.
# OBV_PLAYWRIGHT_NODE_PATH=/app/node_modules

# ==================== EXTERNAL PILOT / PRODUCTION =====================
# THE environment declaration. "demo" (default) keeps every development
# affordance; "pilot" and "production" disable the demo role switcher,
# demo reset, demo seeding, golden seed and every banking simulation
# surface, and make OBV_SESSION_SECRET + OBV_DATA_DIR + an explicit
# OBV_AUTH_LINK_DELIVERY choice mandatory. Contradictory flags (e.g.
# pilot + OBV_DEMO_AUTH=1) refuse startup.
# OBV_ENVIRONMENT=pilot

# Session signing secret (>= 32 chars). REQUIRED in pilot/production.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# OBV_SESSION_SECRET=

# --------- production email (Postmark — the one live adapter) ---------
# OBV_EMAIL_PROVIDER=postmark plus OBV_INTEGRATIONS_PRODUCTION_ENABLE=true
# activates real transactional email. Credentials are env-only: never
# stored in the database, never logged, never committed.
# OBV_EMAIL_PROVIDER=postmark
# OBV_INTEGRATIONS_PRODUCTION_ENABLE=true
# OBV_POSTMARK_SERVER_TOKEN=
# OBV_EMAIL_FROM=obv@yourlender.com
# OBV_POSTMARK_MESSAGE_STREAM=outbound
# OBV_EMAIL_TIMEOUT_MS=10000

# ------------------------------ backups -------------------------------
# Backups are VACUUM INTO snapshots under <OBV_DATA_DIR>/backups with
# sha256 + verification records. Run `npm run backup` manually or from an
# external scheduler; OBV never auto-deletes backup files (retention is
# metadata). There is deliberately no in-app restore.
# OBV_BACKUP_DIR=
# OBV_BACKUP_RETENTION_DAYS=30

# ===================== OPTIONAL — IDENTITY PLATFORM ====================
# Production sign-in is passwordless: users request a one-time emailed
# link at /signin. Under production posture (OBV_BANKING_MODE=production
# or OBV_SESSION_REQUIRE_SECRET=1) this replaces the demo role switcher.
#
# First-admin bootstrap: when the identities table is EMPTY at startup
# and this email is set, OBV creates the founding identity, organization
# and administrator so the first sign-in link has somewhere to land.
# OBV_BOOTSTRAP_ADMIN_EMAIL=
# OBV_BOOTSTRAP_ORG_NAME=

# How sign-in links leave the process. "email" delivers them through the
# configured OBV_EMAIL_PROVIDER (the pilot/production setting — requires
# a real provider, never falls back to the outbox); "file" appends them
# to auth-outbox.jsonl under the data directory (development outbox);
# "off" mints but never delivers. REQUIRED under production posture —
# startup refuses until a mode is chosen explicitly. Pilot: use "email".
# OBV_AUTH_LINK_DELIVERY=

# Tuning (defaults shown in docs/IDENTITY_PLATFORM.md): link TTL and
# issuance throttle, session idle/absolute windows, trusted-device
# window, and brute-force lockout thresholds.
# OBV_AUTH_LINK_TTL_MINUTES=
# OBV_AUTH_LINK_MAX_PER_WINDOW=
# OBV_AUTH_LINK_WINDOW_MINUTES=
# OBV_AUTH_IDLE_MINUTES=
# OBV_AUTH_ABSOLUTE_HOURS=
# OBV_AUTH_TRUSTED_DEVICE_DAYS=
# OBV_AUTH_LOCKOUT_THRESHOLD=
# OBV_AUTH_LOCKOUT_WINDOW_MINUTES=
# OBV_AUTH_LOCKOUT_MINUTES=

# ==================== OPTIONAL — INTEGRATIONS PLATFORM ==================
# Provider-neutral integrations. Defaults are the safe, credential-free
# modes (outbox / internal / csv). Selecting any external vendor requires
# OBV_INTEGRATIONS_PRODUCTION_ENABLE=true as a second explicit consent —
# and the shipped vendor adapters are disabled boundaries that refuse
# every call regardless (no credentials exist in this build).
# OBV_EMAIL_PROVIDER=
# OBV_ESIGN_PROVIDER=
# OBV_ACCOUNTING_PROVIDER=
# OBV_INTEGRATIONS_PRODUCTION_ENABLE=

# Outbound webhook framework: attempts before dead-letter (default 5)
# and an optional periodic dispatch interval in milliseconds (default
# off — dispatch is route-triggered so demos stay deterministic).
# OBV_WEBHOOK_MAX_ATTEMPTS=
# OBV_WEBHOOK_DISPATCH_INTERVAL_MS=

# Local development / test escape hatch: allow webhook endpoints on
# loopback and private ranges. Production leaves this UNSET so the
# egress guard refuses internal destinations (SSRF boundary).
# OBV_WEBHOOK_ALLOW_PRIVATE_HOSTS=

# =============== OPTIONAL — EVIDENCE INTELLIGENCE PLATFORM ==============
# Advisory evidence analysis (duplicate detection, metadata review, OCR,
# document intelligence, scoring). Every output is advisory: it never
# approves a draw, rejects evidence, releases funds, or overrides a
# lender decision. The default OCR provider is a deterministic mock that
# derives fields from a document's own recorded metadata — no credentials,
# fully offline. Selecting a vendor provider (azure_document_intelligence,
# aws_textract, google_document_ai) requires OBV_EVIDENCE_AI_PRODUCTION_ENABLE=true
# as a second explicit consent — and the shipped vendor adapters are
# disabled boundaries that refuse every call regardless (no credentials
# exist in this build). Future perceptual/CV/drone/satellite engines are
# provider-neutral interfaces only and remain DISABLED at the database level.
# OBV_OCR_PROVIDER=
# OBV_EVIDENCE_AI_PRODUCTION_ENABLE=

# ============ OPTIONAL — OFFICIAL SOURCE CONNECTORS PLATFORM ============
# Provider-neutral connectors for official government/licensing sources.
# Everything is retrieval-of-evidence for HUMAN review: no connector can
# approve a draw, record an inspection result, alter a permit basis,
# clear an exception, or move funds. All automated retrieval is disabled
# until the operator configures the documented official endpoint for each
# source (copied from the dataset's/API's official documentation page —
# endpoints are never guessed). Sources without a supported automated
# access method (DOB inspections/enforcement via Scout, DLCP professional
# licenses) remain manual portal lookups by design.
#
# Per-source endpoint overrides (OBV_SOURCE_<ID>_URL):
# OBV_SOURCE_DC_DOB_BUILDING_PERMITS_URL=
# OBV_SOURCE_DC_DOB_CERTIFICATES_OCCUPANCY_URL=
# OBV_SOURCE_DC_DLCP_BUSINESS_LICENSES_URL=
# OBV_SOURCE_DC_PROPERTY_PARCELS_URL=
# OBV_SOURCE_DC_DDOT_TOPS_PERMITS_URL=
#
# DDOT TOPS license key (registered with DDOT; sent as a Bearer token per
# the official API guide). Name only — never commit a value.
# OBV_SOURCE_DC_DDOT_TOPS_PERMITS_KEY=
#
# Scheduled polling stays OFF until explicitly enabled; refreshes are
# otherwise explicit authorized actions. The interval (minutes, min 5)
# applies to external scheduler invocations of the poll API.
# OBV_SOURCES_POLLING_ENABLE=
# OBV_SOURCES_POLL_INTERVAL_MINUTES=
#
# Local development / test escape hatch: allow loopback mock source
# servers (also permits plain http). Production leaves this UNSET so the
# egress guard refuses private hosts and non-HTTPS endpoints.
# OBV_SOURCES_ALLOW_PRIVATE_HOSTS=

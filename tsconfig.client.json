{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2022",
    "moduleResolution": "bundler",
    "outDir": "public/js",
    "rootDir": "src/client",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // Browser bundle: no ambient Node globals may leak into client code.
    "types": []
  },
  "include": ["src/client/**/*"]
}
